public class SerpApiClient\
\{\
    private const string SerpApiUrl = "https://serpapi.com/search";\
    private readonly string _apiKey;\
\
    public SerpApiClient(string apiKey)\
    \{\
        _apiKey = apiKey;\
    \}\
\
    public async Task<JObject> SearchAsync(string query)\
    \{\
        using (var client = new HttpClient())\
        \{\
            var requestUrl = $"\{SerpApiUrl\}?q=\{Uri.EscapeDataString(query)\}&api_key=\{_apiKey\}";\
            var response = await client.GetAsync(requestUrl);\
            response.EnsureSuccessStatusCode();\
            var json = await response.Content.ReadAsStringAsync();\
            return JObject.Parse(json);\
        \}\
    \}\
\
    public static async Task Main(string[] args)\
    \{\
        var apiKey = "YOUR_API_KEY";\
        var client = new SerpApiClient(apiKey);\
        var results = await client.SearchAsync("Coffee");\
        Console.WriteLine(results);\
    \}\
\}\
